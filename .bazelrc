# Bound the local server: it exits after 120 s idle (TIN-5770, R470).
startup --max_idle_secs=120

common --enable_bzlmod

build --verbose_failures
test --test_output=errors

# No remote lane is enrolled. Never fall back to local behind a remote one
# (TIN-5770, R471).
build --remote_local_fallback=false
